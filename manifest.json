{
  "name": "My Resume Site",
  "short_name": "Resume",
  "description": "This is a Resume site on my portfolio.",
  "version": "1.0.0",
  "start_url": "/",
  "display": "standalone",
  "orientation": "any",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://cookieinfoscript.com/*",
    "*://google-analytics.com/*",
    "*://tagmanager.google.com/*",
    "*://fonts.googleapis.com/*"
  ],
  "content_security_policy": "script-src 'self' 'nonce-randomNonceValue' https://www.googletagmanager.com https://google-analytics.com https://www.clarity.ms; object-src 'none';",
  "background_color": "#3367D6",
  "theme_color": "#3367D6",
  "icons": [
    {
      "src": "/static/fonts/fontawesome-webfont.svg",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}